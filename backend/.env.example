NODE_ENV=development
HOST=127.0.0.1
PORT=5174

# Fixture 只允许本地/测试显式开启；生产环境即使设为 1 也会 fail closed。
OMO_DEMO_MODE=0

QWEN_API=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-vl-plus
QWEN_TIMEOUT_MS=60000

TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.io
TIKHUB_TIMEOUT_MS=15000

# 当前 JSON Store 只用于本地开发，不满足生产 readiness。
CARD_STORE_PATH=.runtime/cards.json

# PostgreSQL 只在显式提供 DATABASE_URL 时启用；值留空且不得提交真实凭据。
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
