# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=5173

# PostgreSQL; omit for in-memory local mode.
DATABASE_URL=
PGSSLMODE=disable
GENERATION_WORKER_DISABLED=1

# Model: qwen, openai_compatible, deepseek, or openai.
AI_PROVIDER=qwen
AI_MODEL=qwen-flash
QWEN_API=
BASE_URL=
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
MODEL_REQUEST_TIMEOUT_MS=45000

# One-call quick review.
QUICK_REVIEW_MAX_INPUT_CHARS=12000
QUICK_REVIEW_CACHE_ENABLED=1
QUICK_REVIEW_CACHE_TTL_MS=86400000
QUICK_REVIEW_CACHE_MAX_ENTRIES=128

# Source extraction.
VIDEO_LINK_ENABLED=1
VIDEO_MAX_DURATION_SECONDS=900
VIDEO_VISUAL_ENABLED=0
TIKHUB_API_KEY=oqoSAdIL/12OnE6QP4bPxxnxOxq3WLpD6ingmmzRU6SckA2aHna4emjGDQ==
TIKHUB_BASE_URL=https://api.tikhub.io
TIKHUB_SEARCH_HEDGE_DELAY_MS=1200

# Screenshot source recovery. TikHub is the default platform search provider.
# Generic web search variables below are optional and are not required for TikHub search.
SEARCH_API_URL=
SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
PADDLEOCR_PYTHON=.runtime/paddle-ocr/bin/python
YT_DLP_PYTHON=.runtime/paddle-ocr/bin/python
OCR_PROVIDER=paddle
VIDEO_YTDLP_ENABLED=1
# Base64 screenshot payloads need more room than ordinary JSON requests.
SHIBEI_MAX_IMAGE_FLOW_BODY_BYTES=8388608

# ASR fallback. Prefer Qwen Filetrans for a publicly reachable media URL;
# local faster-whisper remains the offline fallback when a platform CDN blocks Qwen.
VIDEO_ASR_PROVIDER=qwen_filetrans
QWEN_ASR_MODEL=qwen3-asr-flash-filetrans
QWEN_ASR_LANGUAGE=auto
QWEN_ASR_TIMEOUT_MS=600000
QWEN_ASR_PARALLEL_THRESHOLD_SECONDS=600
QWEN_ASR_CHUNK_SECONDS=30
QWEN_ASR_CHUNK_CONCURRENCY=12
QWEN_ASR_MAX_CHUNKS=12
QWEN_ASR_SUCCESS_QUORUM=3
LOCAL_ASR_CHUNK_CONCURRENCY=5
LOCAL_ASR_SUCCESS_QUORUM=3
LOCAL_WHISPER_MODEL=tiny
LOCAL_WHISPER_CPU_THREADS=2
LOCAL_WHISPER_MAX_PROCESSES=5
# Production only: the HTTPS address Qwen can reach. The backend exposes a
# one-time /api/asr-media/<token> URL for the downloaded audio while Qwen ASR runs.
SHIBEI_PUBLIC_BASE_URL=https://your-public-backend.example.com
LOCAL_WHISPER_BEAM_SIZE=1
LOCAL_WHISPER_LANGUAGE=auto
LOCAL_WHISPER_PERSISTENT_ENABLED=1
LOCAL_WHISPER_PREWARM_WORKERS=5
LOCAL_ASR_PARALLEL_THRESHOLD_SECONDS=30
LOCAL_ASR_CHUNK_SECONDS=10
LOCAL_ASR_MAX_CHUNKS=12
