{
  "name": "recallo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:local": "bash tools/local-backend-env.sh setup",
    "dev": "npm --prefix backend run dev",
    "start": "npm --prefix backend start",
    "worker": "npm --prefix backend run worker",
    "build": "npm --prefix backend install",
    "security:secrets": "node tools/secret-scan.mjs --current",
    "security:secrets:test": "node --test tools/secret-scan.test.mjs tools/security-workflow-contract.test.mjs tools/worktree-root-policy.test.mjs",
    "security:secrets:history": "node tools/secret-scan.mjs --history",
    "check": "npm run security:secrets && npm run security:secrets:test && npm --prefix backend run check && node --check tools/local-backend-smoke.mjs && node --check tools/recallo-workspace-guard.mjs && node tools/recallo-workspace-guard.mjs",
    "check:ios": "node tools/ios-production-guard.mjs",
    "test:web-e2e": "node tools/web-app-demo-e2e.mjs",
    "smoke": "node tools/local-backend-smoke.mjs",
    "db:start": "bash tools/local-backend-env.sh start",
    "db:stop": "bash tools/local-backend-env.sh stop",
    "db:status": "bash tools/local-backend-env.sh status",
    "doctor": "bash tools/local-backend-env.sh doctor"
  },
  "engines": { "node": ">=20" }
}
